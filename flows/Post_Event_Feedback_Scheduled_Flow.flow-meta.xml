<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Schedule-Triggered Flow running daily to send post-event feedback survey emails in bulk to confirmed attendees.</description>
    <environments>Default</environments>
    <interviewLabel>Post Event Feedback Scheduled Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Post Event Feedback Scheduled Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Confirmed_Registrations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Approval_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <object>Event__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-09-04</startDate>
            <startTime>01:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <actionCalls>
        <name>Send_Feedback_Email</name>
        <label>Send Feedback Email</label>
        <locationX>50</locationX>
        <locationY>750</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddressesArray</name>
            <value>
                <elementReference>colFeedbackEmails</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>formulaFeedbackSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>formulaFeedbackBody</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <assignments>
        <name>Assign_Feedback_Email</name>
        <label>Add Email to List</label>
        <locationX>264</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>colFeedbackEmails</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Registrations.Attendee__r.Email__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Registrations</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_Has_Feedback_Recipients</name>
        <label>Has Recipients?</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <defaultConnectorLabel>No Recipients</defaultConnectorLabel>
        <rules>
            <name>Has_Recipients_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>colFeedbackEmails</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Feedback_Email</targetReference>
            </connector>
            <label>Has Recipients</label>
        </rules>
    </decisions>
    <formulas>
        <name>formulaFeedbackSubject</name>
        <dataType>String</dataType>
        <expression>"How was your experience at " &amp; {!$Record.Name} &amp; "?"</expression>
    </formulas>
    <formulas>
        <name>formulaFeedbackBody</name>
        <dataType>String</dataType>
        <expression>"Thank you for attending " &amp; {!$Record.Name} &amp; "! We value your opinion. Please take a moment to share your feedback and help us improve future sessions."</expression>
    </formulas>
    <loops>
        <name>Loop_Registrations</name>
        <label>Loop Registrations</label>
        <locationX>176</locationX>
        <locationY>250</locationY>
        <collectionReference>colConfirmedRegistrations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Feedback_Email</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Decision_Has_Feedback_Recipients</targetReference>
        </noMoreValuesConnector>
    </loops>
    <recordLookups>
        <name>Get_Confirmed_Registrations</name>
        <label>Get Registrations Needing Feedback</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Registrations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Event__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Registration_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Confirmed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Feedback_Submitted__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Registration__c</object>
        <outputReference>colConfirmedRegistrations</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Attendee__c</queriedFields>
    </recordLookups>
    <variables>
        <name>colConfirmedRegistrations</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Registration__c</objectType>
    </variables>
    <variables>
        <name>colFeedbackEmails</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>