<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Schedule-Triggered Flow running to send 24-hour reminder emails to confirmed registrants for upcoming events.</description>
    <environments>Default</environments>
    <interviewLabel>Event Reminder Scheduled Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Event Reminder Scheduled Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_Event_Starts_Tomorrow</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Approval_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Publication_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Published</stringValue>
            </value>
        </filters>
        <object>Event__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-09-04</startDate>
            <startTime>00:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <actionCalls>
        <name>Send_Reminder_Email</name>
        <label>Send Reminder Email</label>
        <locationX>440</locationX>
        <locationY>576</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Loop_Confirmed_Registrations</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Loop_Confirmed_Registrations</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Loop_Confirmed_Registrations.Attendee__r.Email__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>formulaReminderSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>formulaReminderBody</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <decisions>
        <name>Decision_Event_Starts_Tomorrow</name>
        <label>Event Starts Tomorrow?</label>
        <locationX>50</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>Not Tomorrow</defaultConnectorLabel>
        <rules>
            <name>Starts_Tomorrow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaIsEventTomorrow</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Confirmed_Registrations</targetReference>
            </connector>
            <label>Starts Tomorrow</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Has_Valid_Email</name>
        <label>Has Valid Email?</label>
        <locationX>352</locationX>
        <locationY>468</locationY>
        <defaultConnector>
            <targetReference>Loop_Confirmed_Registrations</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Valid Email</defaultConnectorLabel>
        <rules>
            <name>Valid_Email_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Confirmed_Registrations.Attendee__r.Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Confirmed_Registrations.Attendee__r.Email__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Reminder_Email</targetReference>
            </connector>
            <label>Valid Email Found</label>
        </rules>
    </decisions>
    <formulas>
        <name>formulaIsEventTomorrow</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!$Record.Start_Date_Time__c})) &amp;&amp; (DATEVALUE({!$Record.Start_Date_Time__c}) - {!$Flow.CurrentDate} = 1)</expression>
    </formulas>
    <formulas>
        <name>formulaReminderSubject</name>
        <dataType>String</dataType>
        <expression>"Reminder: " &amp; {!$Record.Name} &amp; " starts tomorrow!"</expression>
    </formulas>
    <formulas>
        <name>formulaReminderBody</name>
        <dataType>String</dataType>
        <expression>"Hello, this is a friendly reminder that " &amp; {!$Record.Name} &amp; " is scheduled to start on " &amp; TEXT({!$Record.Start_Date_Time__c}) &amp; " at " &amp; {!$Record.Venue__r.Name} &amp; ". We look forward to seeing you there!"</expression>
    </formulas>
    <loops>
        <name>Loop_Confirmed_Registrations</name>
        <label>Loop Confirmed Registrations</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <collectionReference>colConfirmedRegistrations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Has_Valid_Email</targetReference>
        </nextValueConnector>
    </loops>
    <recordLookups>
        <name>Get_Confirmed_Registrations</name>
        <label>Get Confirmed Registrations</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Confirmed_Registrations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Event__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Registration_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Confirmed</stringValue>
            </value>
        </filters>
        <object>Registration__c</object>
        <outputReference>colConfirmedRegistrations</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Attendee__c</queriedFields>
    </recordLookups>
    <variables>
        <name>colConfirmedRegistrations</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Registration__c</objectType>
    </variables>
</Flow>