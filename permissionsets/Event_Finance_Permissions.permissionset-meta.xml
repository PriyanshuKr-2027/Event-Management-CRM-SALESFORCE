<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants Finance Team access to track incoming payments, transaction settlements, and event revenue realization.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Event Finance Permissions</label>

    <!-- Object Permissions: Payment__c -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Payment__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Object Permissions: Registration__c (Read Only) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Registration__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Object Permissions: Event__c (Read Only) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Event__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Object Permissions: Ticket_Type__c (Read Only) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Ticket_Type__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Tab Visibility -->
    <tabSettings>
        <tab>Event__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Payment__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <!-- Application Visibility -->
    <applicationVisibilities>
        <application>Event_Management</application>
        <visible>true</visible>
    </applicationVisibilities>
</PermissionSet>
